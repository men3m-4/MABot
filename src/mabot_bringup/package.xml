<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mabot_bringup</name>
  <version>0.1.0</version>
  <description>Centralized simulation, navigation, and warehouse mission startup for MABot.</description>
  <maintainer email="men3m-4@users.noreply.github.com">Mohamed Abdelmoniem</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mabot_description</exec_depend>
  <exec_depend>mabot_navigation</exec_depend>
  <exec_depend>mabot_slam</exec_depend>
  <exec_depend>mabot_warehouse_waypoints</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
